# Stuff & Puff Chengalpattu Environment Configuration
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost

# Database (Leave blank to use local SQLite, or provide PostgreSQL URL for production)
DATABASE_URL=

# Payment Gateway Configuration (CASHFREE or SANDBOX)
PAYMENT_GATEWAY_PROVIDER=CASHFREE
CASHFREE_CLIENT_ID=your-cashfree-client-id
CASHFREE_CLIENT_SECRET=your-cashfree-client-secret
CASHFREE_ENVIRONMENT=SANDBOX
CASHFREE_API_VERSION=2023-08-01

# Brevo Transactional Email Configuration
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=noreply@example.com
BREVO_SENDER_NAME=Stuff & Puff

